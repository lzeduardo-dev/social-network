# Copie para .env e preencha. Gere a chave com: openssl rand -base64 32
JWT_SECRET=

# AWS S3 (armazenamento de midias)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Desenvolvimento com LocalStack (docker compose up localstack).
# Use estes valores ao rodar a aplicacao fora do Docker:
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_S3_BUCKET=rede-social-media
# AWS_S3_ENDPOINT=http://localhost:4566
# AWS_S3_PUBLIC_URL=http://localhost:4566/rede-social-media
